APP_NAME="SV Business Platform"
APP_ENV=local
APP_KEY=base64:zQS4ynIyJ4E6m7hD+Hvdzf7KPUXm+woGNoAu4edDCp8=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# --- Databases (gebruikersnamen zijn gelijk aan de databasenamen) ---
DB_CONNECTION=central

DB_CENTRAL_HOST=localhost
